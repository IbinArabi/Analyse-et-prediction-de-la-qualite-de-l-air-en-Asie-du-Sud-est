      "source": [
        "# ========================\n",
        "# 4. NETTOYAGE DES DONNÉES\n",
        "# ========================\n",
        "\n",
        "print(\"\\n--- 4. NETTOYAGE DES DONNÉES ---\")\n",
        "\n",
        "# 4.1 Remplacement des valeurs négatives par NaN\n",
        "polluants = ['PM2.5', 'PM10', 'NO2', 'SO2', 'CO']\n",
        "for col in polluants:\n",
        "    df[col] = df[col].apply(lambda x: np.nan if x < 0 else x)\n",
        "\n",
        "print(\"🔧 Nombre de valeurs négatives transformées en NaN :\")\n",
        "for col in polluants:\n",
        "    nb = df[col].isnull().sum()\n",
        "    if nb > 0:\n",
        "        print(f\"   {col} : {nb} valeurs négatives remplacées par NaN\")\n",
        "\n",
        "# 4.2 Imputation par la médiane\n",
        "for col in polluants:\n",
        "    mediane = df[col].median()\n",
        "    df[col].fillna(mediane, inplace=True)\n",
        "\n",
        "print(\"\\n✅ Après imputation par la médiane, aucune valeur manquante :\", df.isnull().sum().sum())\n",
        "print(\"📝 Interprétation : Les concentrations négatives, physiquement impossibles, ont été corrigées par imputation à la médiane, méthode robuste aux valeurs extrêmes.\")\n"
      ]
