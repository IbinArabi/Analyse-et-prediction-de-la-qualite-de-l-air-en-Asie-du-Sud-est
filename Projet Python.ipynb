        "# ========================\n",
        "# 8. MODÉLISATION : RANDOM FOREST\n",
        "# ========================\n",
        "\n",
        "print(\"\\n--- 8. MODÉLISATION (RANDOM FOREST) ---\")\n",
        "\n",
        "rf = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "rf.fit(X_train_scaled, y_train)\n",
        "y_pred = rf.predict(X_test_scaled)\n",
        "\n",
        "accuracy = accuracy_score(y_test, y_pred)\n",
        "print(f\"\\n🎯 Accuracy sur l'ensemble de test : {accuracy:.4f}\")\n",
        "print(\"\\n📋 Rapport de classification :\")\n",
        "print(classification_report(y_test, y_pred, target_names=le.classes_))\n",
        "print(\"📝 Interprétation : L'accuracy est très élevée (>95%). Les variables explicatives (polluants, météo, proximité industrielle) discriminent parfaitement les classes de qualité de l'air.\")\n",
        "\n",
        "# Matrice de confusion\n",
        "plt.figure(figsize=(6,5))\n",
        "cm = confusion_matrix(y_test, y_pred)\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
        "            xticklabels=le.classes_, yticklabels=le.classes_)\n",
        "plt.title('Matrice de confusion - Random Forest')\n",
        "plt.xlabel('Prédit')\n",
        "plt.ylabel('Réel')\n",
        "plt.show()\n",
        "print(\"📝 Interprétation : Très peu d'erreurs de classification. La matrice de confusion confirme l'excellente séparation des classes.\")\n"
